#!/bin/bash
################################
#william@william.co.il 03.2025 #
#1.2 (Modern macOS update)     #
#see -h/--help for usage       #
################################

# Ensure common binary paths are in PATH (Intel & Apple Silicon Homebrew, user paths)
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:$PATH"

# Generate random alphanumeric string with fallback if pwgen is missing
gen_random_str() {
    local len="${1:-10}"
    if command -v pwgen >/dev/null 2>&1; then
        pwgen -A "$len" 1
    elif [ -x "/opt/homebrew/bin/pwgen" ]; then
        /opt/homebrew/bin/pwgen -A "$len" 1
    elif [ -x "/usr/local/bin/pwgen" ]; then
        /usr/local/bin/pwgen -A "$len" 1
    else
        LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$len"
    fi
}

# Notification helper: tries terminal-notifier if available, otherwise native macOS display notification
notify() {
    local title="$1"
    local msg="$2"
    if command -v terminal-notifier >/dev/null 2>&1; then
        terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2>/dev/null || \
        osascript -e "display notification \"$msg\" with title \"$title\""
    elif [ -x "/opt/homebrew/bin/terminal-notifier" ]; then
        /opt/homebrew/bin/terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2>/dev/null || \
        osascript -e "display notification \"$msg\" with title \"$title\""
    elif [ -x "/usr/local/bin/terminal-notifier" ]; then
        /usr/local/bin/terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2>/dev/null || \
        osascript -e "display notification \"$msg\" with title \"$title\""
    else
        osascript -e "display notification \"$msg\" with title \"$title\""
    fi
}

# Default temporary directory: use TMPDIR or /tmp (avoids read-only system volume when PWD=/ in Automator)
tmpdir="${TMPDIR:-/tmp/}"
[[ "${tmpdir}" != */ ]] && tmpdir="${tmpdir}/"

# Default server, also used for Finder integration if not set in next
srvv="server1"
# Finder integration default server
fsrvv="${srvv}"

# Default packager (zip/rar)
pkgs="zip"

# Password file (expanded with HOME)
pwfile="${HOME}/.upl"

# Copy URL to clipboard (except on -c/CLI usage)
copy=1

# Copy password to clipboard (except on -c/CLI usage)
copyp=1

# Structure of filenames used server side
tname="$(head -c 1024 /dev/urandom | md5)-$(gen_random_str 10)"
# This default results in:
# 89794z52e03b39d2fd34a7033b067847-phaiv8tlis.EXT

# Server config, self explanatory
if [ "$srvv" == "server1" ]; then
        srvv_host="no.inbox.li"
        srvv_user="root"
        srvv_key="${HOME}/.ssh/id_ed25519"
        srvv_path="/server/www/no.inbox.li/file"
        srvv_port="22"
        srvv_url="https://no.inbox.li/file"
        chown="www-data:www-data"
elif [ "$srvv" == "server2" ]; then
        srvv_host="10.4.5.12"
        srvv_user="ubuntu"
        srvv_key="${HOME}/.ssh/aws_key_bundle"
        srvv_path="/dat/lz"
        srvv_port="2222"
        srvv_url="https://nlocalsrv:8888/lbz/store/2016/12"
        chown="www-data:www-data"
fi
srvv_key="${srvv_key/#\~/$HOME}"


### Actual script
# macOS things, enable single binary from Automator for Finder integration
if [ "$1" == "AUTOMATOR" ] || [ "$1" == "AUTOMATORENC" ] || [ "$1" == "AUTOMATORORG" ]; then
	act="$1"
	shift
	fullll="$*"
	feargs=""
	if [ "$act" == "AUTOMATORORG" ]; then
		feargs='-o'
	fi
	if [ "$act" == "AUTOMATORENC" ]; then
		feargs='-p -e'
	fi

	# Locate self or installed binary
	if [ -x "${BASH_SOURCE[0]}" ]; then
		SELF="${BASH_SOURCE[0]}"
	elif command -v ulf >/dev/null 2>&1; then
		SELF="$(command -v ulf)"
	elif [ -x "/opt/homebrew/bin/ulf" ]; then
		SELF="/opt/homebrew/bin/ulf"
	elif [ -x "/usr/local/bin/ulf" ]; then
		SELF="/usr/local/bin/ulf"
	else
		SELF="ulf"
	fi

	fileu=$("$SELF" ${feargs} -c -s "${fsrvv}" -i "${fullll}")
	sub_status=$?
	if [ $sub_status -ne 0 ] || [ -z "${fileu}" ]; then
		notify "Upload Error" "Upload failed - check network or server configuration."
		exit 1
	fi

	filel=$(echo "${fileu}" | awk '{print $1}')
	filep=$(echo "${fileu}" | awk '{print $2}')

	# Verify remote file accessibility (supports HTTP/1.1, HTTP/2, and HTTP/3)
	http_code=$(curl -s -k -o /dev/null -w "%{http_code}" --head "${filel}")
	if [ "$http_code" = "200" ] || [ "$http_code" = "301" ] || [ "$http_code" = "302" ]; then
		if [ -n "${filep}" ]; then
			echo "${filel} ${filep}"
		else
			echo "${filel}"
		fi
		exit 0
	else
		notify "Upload Error" "Upload verification failed (HTTP ${http_code})."
		exit 1
	fi
fi


# Help function
function helpgen {
echo "Uploads on macOS - william@william.co.il 03.2025"
echo ""
echo "This script uploads files with new random filename, original filename in a random subfolder or packaged as RAR or ZIP, encrypted if desired."
echo "By default the URL is automatically copied to the clipboard, a config option also enables password copy."
echo "Passwords are by default also saved in a local file with the filename and upload date."
echo ""
echo "Switches:"
echo "-h / --help              - This help output"
echo "-c / --cli               - CLI mode for eg. shell usage, returns only URL on stdout if successful or exits with 1"
echo "-i / --input             - File to upload, full path or relative path. Quotes recommended."
echo "-s / --server            - Target server config to use (default: ${srvv})"
echo "-nc / --nocopy           - Do not copy file URL to clipboard, only stdout it"
echo "-o / --original          - Keep original filename, in a random subfolder for this upload"
echo "-p / --package           - Enable packaging of file (automatically enabled for directories)"
echo "-e / --encrypt           - Encrypt file. Enables packaging automatically."
echo "-cp / --copypassword     - Copy password after link into clipboard (default enabled)"
echo "-ncp / --nocopypassword  - Do not copy password to clipboard"
echo "-nsp                     - Do not save password to local file (default: ${pwfile})"
echo "-rar                     - Use RAR format instead of ZIP (default: zip)"
echo "-t / --tmpdir            - Set temporary ZIP/RAR directory (default: ${tmpdir})"
echo "-automator               - Echo Automator Quick Action shell script for macOS Finder integration"
exit 0
}

# Function to echo Automator config
function echo_am_config {
cat << 'EOF'
#!/bin/bash
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:$PATH"

notify() {
	local title="$1"
	local msg="$2"
	if command -v terminal-notifier >/dev/null 2>&1; then
		terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2>/dev/null || \
		osascript -e "display notification \"$msg\" with title \"$title\""
	elif [ -x "/opt/homebrew/bin/terminal-notifier" ]; then
		/opt/homebrew/bin/terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2>/dev/null || \
		osascript -e "display notification \"$msg\" with title \"$title\""
	elif [ -x "/usr/local/bin/terminal-notifier" ]; then
		/usr/local/bin/terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2>/dev/null || \
		osascript -e "display notification \"$msg\" with title \"$title\""
	else
		osascript -e "display notification \"$msg\" with title \"$title\""
	fi
}

# Resolve ulf path
if command -v ulf >/dev/null 2>&1; then
	ULF_BIN="$(command -v ulf)"
elif [ -x "/opt/homebrew/bin/ulf" ]; then
	ULF_BIN="/opt/homebrew/bin/ulf"
elif [ -x "/usr/local/bin/ulf" ]; then
	ULF_BIN="/usr/local/bin/ulf"
else
	ULF_BIN="ulf"
fi

TMP_OUT="$(mktemp "${TMPDIR:-/tmp}/ulf.XXXXXXXXXX")"

for filen in "$@"; do
	fileb="$(basename "${filen}")"
	start=$(date +%s)
	ssize=$(du -ch "${filen}" 2>/dev/null | tail -1 | sed -e 's+total++' | xargs)
	notify "Upload Started" "Uploading: ${fileb} - Size: ${ssize}"

	result=$("$ULF_BIN" AUTOMATOR "${filen}")
	status=$?

	if [ $status -eq 0 ] && [ -n "$result" ]; then
		end=$(date +%s)
		timeu=$((end - start))
		notify "Upload Finished" "Uploaded: ${fileb} - Time: ${timeu} sec"
		echo "${result}" >> "$TMP_OUT"
	else
		notify "Upload Failed" "Failed to upload: ${fileb}"
	fi
done

if [ -s "$TMP_OUT" ]; then
	cat "$TMP_OUT" | pbcopy
	notify "Upload Complete" "Your upload is finished and the link(s) have been copied."
fi
rm -f "$TMP_OUT"
EOF
exit 0
}


# Get the switches
while [ "x$#" != "x0" ]; do
        value=""
        case "$1" in
                -h|--help)
                        helpgen
                ;;
                -e|--encrypt)
                        enc=1
                ;;
                -p|--package)
                        pkg=1
                ;;
		-c|--cli)
			cli=1
		;;
                -i|--input)
                        value=$(echo -n "$1" | sed -E 's/^--?[a-z]+=//')
                        [ "x$value" == "x$1" ] && value=""
                        [ "x$value" == "x" ] && [ "x${2:0:1}" != "x-" ] && value="$2" && shift
			ff=${value}
                ;;
                -t|--tmpdir)
                        value=$(echo -n "$1" | sed -E 's/^--?[a-z]+=//')
                        [ "x$value" == "x$1" ] && value=""
                        [ "x$value" == "x" ] && [ "x${2:0:1}" != "x-" ] && value="$2" && shift
			tmpdir=${value}
                ;;
                -s|--server)
                        value=$(echo -n "$1" | sed -E 's/^--?[a-z]+=//')
                        [ "x$value" == "x$1" ] && value=""
                        [ "x$value" == "x" ] && [ "x${2:0:1}" != "x-" ] && value="$2" && shift
                        srvv=${value}
		;;
		-o|--original)
			org=1
		;;
		-nc|--nocopy)
			if [ "$copy" == "1" ]; then unset copy; fi
                ;;
		-rar)
			pkgs="rar"
		;;
		-nsp)
			pw_nosave="1"
		;;
		-cp|--copypassword)
			copyp="1"
		;;
		-ncp|--nocopypassword)
			copyp="0"
		;;
		-automator)
			echo_am_config
		;;
        esac
        shift
done

if [ -z "$srvv" ]; then
	echo "Err: No target server specified - set default one in script or use -s switch to supply it" >&2
	exit 1
fi

if [ -z "$ff" ]; then
	echo "Err: No File/Dir supplied - use the -i switch to supply it." >&2
	exit 1
fi

# Expand tildes in paths
ff="${ff/#\~/$HOME}"
tmpdir="${tmpdir/#\~/$HOME}"
[[ "${tmpdir}" != */ ]] && tmpdir="${tmpdir}/"

if [ -f "$ff" ]; then
	ty=f
elif [ -d "$ff" ]; then
	ty=d
else
	echo "File/Dir does not exist: $ff" >&2
	exit 1
fi

oname="$(basename "${ff}")"
parent_dir="$(dirname "${ff}")"

if [ "$ty" == "d" ] && [ -z "$pkg" ]; then
	if [ "$cli" != "1" ]; then
	        echo "Warn: Directory supplied but no packaging enabled - enabling"
	fi
	pkg=1
fi

if [ "$enc" == "1" ] && [ -z "$pkg" ]; then
	if [ "$cli" != "1" ]; then
	        echo "Warn: Encryption set but no packaging enabled which is required - enabling"
	fi
	pkg=1
fi

if [ ! -z "$org" ]; then
	if [ "$cli" != "1" ]; then
		echo "Info: Original filename selected - creating remote directory by SSH"
	fi
	ssh -i "${srvv_key}" -p "${srvv_port}" -l "${srvv_user}" "${srvv_host}" "mkdir -p ${srvv_path}${tname}"
	if [ $? -ne 0 ]; then
		echo "Err: mkdir failed by SSH - exiting" >&2
		exit 1
	else
		if [ "$cli" != "1" ]; then
			echo "Info: mkdir ok"
		fi
	fi
fi

if [ ! -z "$enc" ]; then
	passw=$(gen_random_str 32)
	if [ "$cli" != "1" ]; then
		if [ -z "$pw_nosave" ]; then
			echo "Password saved in local file ${pwfile}"
			mkdir -p "$(dirname "${pwfile}")"
			echo "" >> "${pwfile}"
			echo "${tname} ${srvv} $(date) ${passw}" >> "${pwfile}"
			echo "Password:"
			echo ""
			echo "${passw}"
			echo ""
		else
	                echo 'Password NOT saved in local file!!!'
	                echo "Password:"
	                echo ""
	                echo "${passw}"
	                echo ""
		fi
	else
		if [ -z "$pw_nosave" ]; then
			mkdir -p "$(dirname "${pwfile}")"
                        echo "" >> "${pwfile}"
                        echo "${tname} ${srvv} $(date) ${passw}" >> "${pwfile}"
		fi
	fi
	if [ "$pkgs" == "zip" ]; then
		ufile="${tmpdir}${tname}.zip"
		ext=".zip"
		if [ "$cli" != "1" ]; then
			(cd "${parent_dir}" && zip -0 -r -P "${passw}" "${ufile}" "${oname}")
		else
			(cd "${parent_dir}" && zip -0 -r -P "${passw}" "${ufile}" "${oname}") >/dev/null 2>&1
		fi
		if [ $? -ne 0 ] || [ ! -f "${ufile}" ]; then
			echo "Err: Zip packaging failed" >&2
			exit 1
		fi
	elif [ "$pkgs" == "rar" ]; then
		ufile="${tmpdir}${tname}.rar"
		ext=".rar"
		if [ "$cli" != "1" ]; then
			(cd "${parent_dir}" && rar a -m0 -hp"${passw}" "${ufile}" "${oname}")
		else
        		(cd "${parent_dir}" && rar a -m0 -hp"${passw}" "${ufile}" "${oname}") >/dev/null 2>&1
		fi
		if [ $? -ne 0 ] || [ ! -f "${ufile}" ]; then
			echo "Err: RAR packaging failed" >&2
			exit 1
		fi
	fi
fi


if [ -z "$enc" ] && [ ! -z "$pkg" ]; then
        if [ "$pkgs" == "zip" ]; then
		ufile="${tmpdir}${tname}.zip"
		ext=".zip"
		if [ "$cli" != "1" ]; then
	                (cd "${parent_dir}" && zip -0 -r "${ufile}" "${oname}")
		else
			(cd "${parent_dir}" && zip -0 -r "${ufile}" "${oname}") >/dev/null 2>&1
		fi
		if [ $? -ne 0 ] || [ ! -f "${ufile}" ]; then
			echo "Err: Zip packaging failed" >&2
			exit 1
		fi
        elif [ "$pkgs" == "rar" ]; then
		ufile="${tmpdir}${tname}.rar"
		ext=".rar"
		if [ "$cli" != "1" ]; then
	                (cd "${parent_dir}" && rar a -m0 "${ufile}" "${oname}")
		else
			(cd "${parent_dir}" && rar a -m0 "${ufile}" "${oname}") >/dev/null 2>&1
		fi
		if [ $? -ne 0 ] || [ ! -f "${ufile}" ]; then
			echo "Err: RAR packaging failed" >&2
			exit 1
		fi
        fi
fi

if [ -z "$pkg" ]; then
	ufile="${ff}"
	if [[ "$oname" == *.* && "$oname" != .* ]]; then
		ext=".${oname##*.}"
	elif [[ "$oname" == .*.* ]]; then
		ext=".${oname##*.}"
	else
		ext=""
	fi
fi

if [ ! -z "$org" ]; then
	if [ "$cli" != "1" ]; then
		scp -i "${srvv_key}" -P "${srvv_port}" "${ufile}" "${srvv_user}@${srvv_host}:${srvv_path}${tname}/${oname}"
		scp_status=$?
		ssh -i "${srvv_key}" -p "${srvv_port}" -l "${srvv_user}" "${srvv_host}" "chown ${chown} ${srvv_path}${tname}/${oname}"
	else
		scp -i "${srvv_key}" -P "${srvv_port}" "${ufile}" "${srvv_user}@${srvv_host}:${srvv_path}${tname}/${oname}" >/dev/null 2>&1
		scp_status=$?
		ssh -i "${srvv_key}" -p "${srvv_port}" -l "${srvv_user}" "${srvv_host}" "chown ${chown} ${srvv_path}${tname}/${oname}" >/dev/null 2>&1
	fi
else
	if [ "$cli" != "1" ]; then
		scp -i "${srvv_key}" -P "${srvv_port}" "${ufile}" "${srvv_user}@${srvv_host}:${srvv_path}${tname}${ext}"
		scp_status=$?
		ssh -i "${srvv_key}" -p "${srvv_port}" -l "${srvv_user}" "${srvv_host}" "chown ${chown} ${srvv_path}${tname}${ext}"
	else
		scp -i "${srvv_key}" -P "${srvv_port}" "${ufile}" "${srvv_user}@${srvv_host}:${srvv_path}${tname}${ext}" >/dev/null 2>&1
		scp_status=$?
		ssh -i "${srvv_key}" -p "${srvv_port}" -l "${srvv_user}" "${srvv_host}" "chown ${chown} ${srvv_path}${tname}${ext}" >/dev/null 2>&1
	fi
fi

# Clean up temporary package file if created
if [ ! -z "${pkg}" ]; then
	rm -f "${ufile}"
fi

# If SCP failed, exit with 1
if [ $scp_status -ne 0 ]; then
	if [ "$cli" != "1" ]; then
		echo "Err: scp upload failed with exit code ${scp_status}" >&2
	fi
	exit 1
fi

if [ -n "$org" ]; then
	final_url="${srvv_url}/${tname}/${oname}"
else
	final_url="${srvv_url}/${tname}${ext}"
fi

final_out="${final_url}"
if [ -n "$passw" ] && [ "$copyp" == "1" ]; then
	final_out="${final_out} ${passw}"
fi

if [ "$cli" == "1" ]; then
	echo "${final_out}"
else
	echo "Path to file:"
	echo ""
	echo "${final_out}"
	echo ""
	if [ "$copy" == "1" ]; then
		echo -n "${final_out}" | pbcopy
		echo "Copied to clipboard."
	fi
fi
